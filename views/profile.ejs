    <div class="row">
    <div class="col-sm-8 col-sm-offset-2">
    <h2>Add a Recipe</h2>
          <form action="/recipes" method="POST">
            <input type="text" placeholder="Recipe Title" name="title">
            <input type="text" placeholder="URL" name="url">
            <textarea placeholder="Description" name="description" rows="2"></textarea>
            <textarea placeholder="Ingredients" name="ingredients" rows="4"></textarea>
            <textarea placeholder="Instructions" name="instructions" rows="6"></textarea>
            <button type="submit">Submit</button>
          </form>
        
    
       
       
          <h3>Recipes Box</h3>
          <ul class="recipe-box">
          <% for(var i=0; i<recipes.length; i++) {%>
            <li class="recipe" data-id="<%= recipes[i]._id %>">
                <h4><%= recipes[i].title %></h4>
              
                <% if (recipes[i].url) { %>
                <p><a href="<%= recipes[i].url %>" target="_blank">View Recipe</a></p>
              <% } %>

                <% if (recipes[i].ingredients || recipes[i].instructions) { %>
                    <details>
                        <summary>Details</summary>
                        <% if (recipes[i].description) { %>
                            <p><strong>Description:</strong> <%= recipes[i].description %></p>
                        <% } %>
                       <% if (recipes[i].ingredients) { %>
                            <p><strong>Ingredients:</strong> <%= recipes[i].ingredients %></p>
                        <% } %>
                       <% if (recipes[i].instructions) { %>
                            <p><strong>Instructions:</strong> <%= recipes[i].instructions %></p>
                        <% } %>
                    </details>
                <% } %>      
                <div class ="recipe-favs">      
              <span><i class="fa <%= recipes[i].favorite ? 'fa-heart' : 'fa-heart-o' %>" aria-hidden="true"></i></span>
              <span><i class="fa fa-trash-o" aria-hidden="true"></i></span>
                </div>
            </li>
          <% } %>
          </ul>
          </div>
    </div>
</div>
        

<script src="main.js"></script>

</body>
</html>
